// Ready-to-apply policy for hosts/homelab/default.nix.
// The server is a user-owned node, so autogroup:self restricts access to other
// devices signed in as the same Tailscale identity.
{
  "groups": {
    "group:homelab-ssh": ["arpeggio.gns@gmail.com"],
  },
  "grants": [
    {
      "src": ["group:homelab-ssh"],
      "dst": ["autogroup:self"],
      // SSH plus the Tailscale Serve HTTPS ports declared by the homelab host.
      "ip": ["tcp:22", "tcp:443", "tcp:8443-8449"],
    },
  ],
  "ssh": [
    {
      "action": "check",
      "src": ["group:homelab-ssh"],
      "dst": ["autogroup:self"],
      "users": ["kryisnn"],
    },
  ],
}
